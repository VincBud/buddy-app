# Backend-only secrets for Supabase Edge Functions.
#
# These are NEVER bundled with the client app. Copy this file to
# supabase/functions/.env and fill in real values for local `supabase functions
# serve` testing. For deployed environments, set them via:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# or individually in the Supabase Dashboard → Project Settings → Edge Functions.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase at
# function runtime; they are listed here only for local `supabase functions
# serve` so the function can talk back to the database.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# ── Persona Identity Verification ────────────────────────────────────────────
# Find these values in your Persona Dashboard:
#   - PERSONA_API_KEY:        Settings → API Keys (server-side, kept secret)
#   - PERSONA_WEBHOOK_SECRET: Settings → Webhooks → (your webhook) → Signing Secret
#   - PERSONA_TEMPLATE_ID:    Inquiry Templates → your template ID (itmpl_…)
#   - PERSONA_ENVIRONMENT:    "sandbox" or "production"

PERSONA_API_KEY=persona_api_key_here
PERSONA_WEBHOOK_SECRET=persona_webhook_signing_secret_here
PERSONA_TEMPLATE_ID=itmpl_xxxxxxxxxxxxxxxxxxxxxxx
PERSONA_ENVIRONMENT=sandbox
