# Buddy landing page — environment variables.
#
# Copy this file to .env.local and fill in real values for `npm run dev`.
# For Vercel, set these in Project Settings → Environment Variables.
#
# Only NEXT_PUBLIC_* values are exposed to the browser. Do NOT add the
# Supabase service role key here — the landing page only needs the anon key
# (waitlist signups go in via RLS-allowed INSERT).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Optional: public site URL (used for canonical / OG metadata). Defaults to
# the request's origin if unset.
NEXT_PUBLIC_SITE_URL=https://buddy.example.com
